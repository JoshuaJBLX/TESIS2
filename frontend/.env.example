# URL completa del backend, incluyendo el sufijo /api.
# Desarrollo local: deja la variable vacia para usar http://localhost:3000/api
# Vercel:         https://<tu-backend>.vercel.app/api
VITE_API_URL=

# Origen del backend sin sufijo /api (se agrega automaticamente).
# Util cuando el backend vive en otro host/dominio.
PUBLIC_API_ORIGIN=
