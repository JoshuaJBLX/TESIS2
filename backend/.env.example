NODE_ENV=development
PORT=3000
JWT_SECRET=tesis-documental-jwt-secret-2025-change-in-production
JWT_REFRESH_SECRET=tesis-documental-refresh-secret-2025-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DB_PATH=./data/database.sqlite
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# NUBE (Vercel + Supabase)
# ---------------------------------------------------------------------------
# Cadena de conexion de PostgreSQL provista por Supabase
# (Project Settings > Database > Connection string > URI).
# Al definirla, el backend exige el adaptador PostgreSQL descrito en
# doc/04_implementacion_despliegue/plan_nube_vercel_supabase.md
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROYECTO>.supabase.co:5432/postgres

# Secreto del servicio Supabase (para autenticacion administrada desde la nube)
# SUPABASE_URL=https://<PROYECTO>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Orígenes del frontend desplegado, separados por coma.
# CORS_ORIGIN=https://<tu-frontend>.vercel.app
